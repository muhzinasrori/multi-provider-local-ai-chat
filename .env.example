# ── Server ────────────────────────────────────────────────────────────────
PORT=3000

# ── Penyedia AI (isi minimal satu API Key, lalu restart server) ──────────
# Z.AI (Zhipu) — endpoint OpenAI-compatible
ZAI_API_KEY=
# Opsional: override base URL (default: https://api.z.ai/api/paas/v4)
ZAI_BASE_URL=

# Google Gemini — endpoint resmi Google Generative Language API
GEMINI_API_KEY=
# Opsional: override base URL (default: https://generativelanguage.googleapis.com)
GEMINI_BASE_URL=

# OpenAI (contoh penyedia OpenAI-compatible tambahan)
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Ollama (Model AI Lokal)
OLLAMA_API_KEY=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1

# Groq Cloud for cloud ai (endpoint OpenAI-compatible)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Voice / Speech-to-Text (endpoint OpenAI-compatible)
SST_API_KEY=
SST_BASE_URL=

# Text-to-Speech (optional: if empty, automaticly useing msedge-tts)
TTS_API_KEY=
TTS_BASE_URL=
TTS_MODEL=
TTS_VOICE=

# isi System Prompt untuk merubah Karakter AI sesuai dengan yang kamu inginkan
SYSTEM_PROMPT=""

#max token to ai answer output
MAX_TOKENS=28000

# ── Mode uji (tanpa API Key asli) ─────────────────────────────────────────
# Set true untuk menampilkan model "Mock" yang streaming jawaban lokal.
# Berguna untuk mencoba UI (markdown, kode, upload, riwayat) tanpa key.
MOCK_API=false

# ── Batas unggahan file ───────────────────────────────────────────────────
MAX_UPLOAD_MB=20
